# Private host configuration. Copy to runner.env; never commit credentials.
NEXTARGET_APP_DIR=/absolute/path/to/NexTarget/NexTarget-app
NEXTARGET_SERVER_DIR=/absolute/path/to/NexTarget/NexTarget-server
NEXTARGET_SERVER_BRANCH=dev
YVAIN_DEVICE=emulator-5554
YVAIN_AVD=Yvain_Pixel_8_API_34
YVAIN_HOME=/absolute/path/to/.yvain
YVAIN_ANDROID_SDK=/absolute/path/to/Library/Android/sdk
HERMES_UID=1000
HERMES_GID=1000
